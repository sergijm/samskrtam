e\": \"HIGH\",\n  \"forms\": {\n    \"NOMINATIVE\": {\n      \"SINGULAR\": {\"iast\": \"balam\", \"devanagari\": \"बलम्\"},\n      \"DUAL\": {\"iast\": \"bale\", \"devanagari\": \"बले\"},\n      \"PLURAL\": {\"iast\": \"balāni\", \"devanagari\": \"बलानि\"}\n    },\n    \"ACCUSATIVE\": {\n      \"SINGULAR\": {\"iast\": \"balam\", \"devanagari\": \"बलम्\"},\n      \"DUAL\": {\"iast\": \"bale\", \"devanagari\": \"बले\"},\n      \"PLURAL\": {\"iast\": \"balāni\", \"devanagari\": \"बलानि\"}\n    },\n    \"INSTRUMENTAL\": {\n      \"SINGULAR\": {\"iast\": \"balena\", \"devanagari\": \"बलेन\"},\n      \"DUAL\": {\"iast\": \"balābhyām\", \"devanagari\": \"बलाभ्याम्\"},\n      \"PLURAL\": {\"iast\": \"balaiḥ\", \"devanagari\": \"बलैः\"}\n    },\n    \"DATIVE\": {\n      \"SINGULAR\": {\"iast\": \"balāya\", \"devanagari\": \"बलाय\"},\n      \"DUAL\": {\"iast\": \"balābhyām\", \"devanagari\": \"बलाभ्याम्\"},\n      \"PLURAL\": {\"iast\": \"balebhyaḥ\", \"devanagari\": \"बलेभ्यः\"}\n    },\n    \"ABLATIVE\": {\n      \"SINGULAR\": {\"iast\": \"balāt\", \"devanagari\": \"बलात्\"},\n      \"DUAL\": {\"iast\": \"balābhyām\", \"devanagari\": \"बलाभ्याम्\"},\n      \"PLURAL\": {\"iast\": \"balebhyaḥ\", \"devanagari\": \"बलेभ्यः\"}\n    },\n    \"GENITIVE\": {\n      \"SINGULAR\": {\"iast\": \"balasya\", \"devanagari\": \"बलस्य\"},\n      \"DUAL\": {\"iast\": \"balayoḥ\", \"devanagari\": \"बलयोः\"},\n      \"PLURAL\": {\"iast\": \"balānām\", \"devanagari\": \"बलानाम्\"}\n    },\n    \"LOCATIVE\": {\n      \"SINGULAR\": {\"iast\": \"bale\", \"devanagari\": \"बले\"},\n      \"DUAL\": {\"iast\": \"balayoḥ\", \"devanagari\": \"बलयोः\"},\n      \"PLURAL\": {\"iast\": \"baleṣu\", \"devanagari\": \"बलेषु\"}\n    },\n    \"VOCATIVE\": {\n      \"SINGULAR\": {\"iast\": \"bala\", \"devanagari\": \"बल\"},\n      \"DUAL\": {\"iast\": \"bale\", \"devanagari\": \"बले\"},\n      \"PLURAL\": {\"iast\": \"balāni\", \"devanagari\": \"बलानि\"}\n    }\n  }\n}\n\n对于第三个bala，同样。\n\nbalābala (neut):\n{\n  \