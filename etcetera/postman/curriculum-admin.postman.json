{
  "info": {
    "name": "Samskrtam - Curriculum Admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Regenerate Quest Items",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topicId\": \"{{topic_id}}\",\n  \"itemType\": \"DECLENSION_FORM\",\n  \"lexemeLimit\": 5\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:8081/api/v2/curriculum/quest-items/regenerate",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["api", "v2", "curriculum", "quest-items", "regenerate"]
        }
      }
    }
  ],
  "variable": [
    { "key": "admin_token", "value": "" },
    { "key": "topic_id", "value": "" }
  ]
}