{
  "info": {
    "name": "Samskrtam Auth",
    "description": "Получение access_token через api-gateway (ROPC, /api/v1/auth/login). После выполнения login токены автоматически сохраняются в переменные коллекции accessToken/refreshToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090",
      "type": "string"
    },
    {
      "key": "username",
      "value": "ivan",
      "type": "string"
    },
    {
      "key": "password",
      "value": "password",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login (get access_token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        },
        "description": "ROPC login через api-gateway. Gateway отправляет grant_type=password в Keycloak от имени клиента samskrtam-frontend."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.access_token);",
              "pm.collectionVariables.set('refreshToken', json.refresh_token);",
              "pm.test('has access_token', () => pm.expect(json.access_token).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "refresh"]
        },
        "description": "Обновление токена по refresh_token (grant_type=refresh_token)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.access_token);",
              "pm.collectionVariables.set('refreshToken', json.refresh_token);",
              "pm.test('has new access_token', () => pm.expect(json.access_token).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    }
  ]
}
