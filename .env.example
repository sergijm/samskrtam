# ===================================================================
# Переменные для локальной разработки (скопировать в .env)
# ===================================================================

# --- База данных (для всех сервисов) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=samskrtam
DB_USER=postgres
DB_PASSWORD=postgres

SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_R2DBC_URL=r2dbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_FLYWAY_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=samskrtam
KEYCLOAK_JWKS_URI=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=samskrtam-frontend
KEYCLOAK_CLIENT_SECRET= # <-- ВСТАВЬТЕ ВАШ СЕКРЕТ

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://samskrtam.local

# --- Service Ports & Hosts (для локального запуска) ---
API_GATEWAY_PORT=8090
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=8087
CONTENT_SERVICE_HOST=localhost
CONTENT_SERVICE_PORT=8081
QUIZ_SERVICE_HOST=localhost
QUIZ_SERVICE_PORT=8082
DICTIONARY_SERVICE_HOST=localhost
DICTIONARY_SERVICE_PORT=8085
STATISTICS_SERVICE_HOST=localhost
STATISTICS_SERVICE_PORT=8086

# --- Frontend ---
VITE_API_URL=http://${API_GATEWAY_HOST:localhost}:${API_GATEWAY_PORT}
VITE_KEYCLOAK_URL=${KEYCLOAK_URL}
VITE_KEYCLOAK_REALM=${KEYCLOAK_REALM}
VITE_KEYCLOAK_CLIENT_ID=${KEYCLOAK_CLIENT_ID}
