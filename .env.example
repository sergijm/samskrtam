# ===================================================================
# Example Environment Variables for Local Development
# Copy this file to .env and fill in the secrets.
# ===================================================================

# ── Spring Profiles ─────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Database (PostgreSQL) ───────────────────────────────
DB_HOST=mdm-dev
DB_PORT=5432
DB_NAME=samskrtam
DB_USER=postgres
DB_PASSWORD=postgres

# ── JDBC & R2DBC URLs (derived from above) ──────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_R2DBC_URL=r2dbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_FLYWAY_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── Redis ───────────────────────────────────────────────
REDIS_HOST=mdm-dev
REDIS_PORT=6379

# ── Kafka ───────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=mdm-dev:9092
KAFKA_STREAMS_APPLICATION_ID=akshara-marga

# ── Keycloak ────────────────────────────────────────────
# Direct URL for service-to-service communication
KEYCLOAK_URL=https://keycloak.sm.dev
KEYCLOAK_INTERNAL_URL=http://keycloak.sm.dev:10280

# Public-facing URL for issuer validation
KEYCLOAK_ISSUER_URL=https://keycloak.sm.dev
KEYCLOAK_REALM=samskrtam
# Use the direct URL for fetching keys
KEYCLOAK_JWKS_URI=${KEYCLOAK_INTERNAL_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs

# Keycloak Admin credentials for user-service
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID_ADMIN=admin-cli
KEYCLOAK_CLIENT_SECRET_ADMIN=7kygDlSfLuhnKqlA7ciOAX9Zh5fkay4d

# Keycloak credentials for frontend
KEYCLOAK_CLIENT_ID=samskrtam-frontend
KEYCLOAK_CLIENT_SECRET=XwyoGmKmKTRaDamMuPRnUJa6GARkA7Y9
GATEWAY_URL=http://samskrtam.local

# ── Service Ports ───────────────────────────────────────
API_GATEWAY_PORT=8090
USER_SERVICE_PORT=8087
CONTENT_SERVICE_PORT=8081
QUIZ_SERVICE_PORT=8082
DICTIONARY_SERVICE_PORT=8085
STATISTICS_SERVICE_PORT=8086
SANGRAHA_SERVICE_PORT=8089
CURRICULUM_SERVICE_PORT=8091
LESSON_SERVICE_PORT=8092
# Common port for all actuators
MANAGEMENT_PORT=8099

# ── Service URLs (for inter-service communication) ──────
USER_SERVICE_URL=http://localhost:${USER_SERVICE_PORT}
CONTENT_SERVICE_URL=http://localhost:${CONTENT_SERVICE_PORT}
QUIZ_SERVICE_URL=http://localhost:${QUIZ_SERVICE_PORT}
DICTIONARY_SERVICE_URL=http://localhost:${DICTIONARY_SERVICE_PORT}
STATISTICS_SERVICE_URL=http://localhost:${STATISTICS_SERVICE_PORT}
SANGRAHA_SERVICE_URL=http://localhost:${SANGRAHA_SERVICE_URL}
CURRICULUM_SERVICE_URL=http://localhost:${CURRICULUM_SERVICE_PORT}
LESSON_SERVICE_URL=http://localhost:${LESSON_SERVICE_PORT}

# Quiz declension-session: вопросы каждого типа за сессию (curriculum-service v2)
QUIZ_DECLENSION_SINGLE_CHOICE_COUNT=5
QUIZ_DECLENSION_FREE_TEXT_COUNT=5
QUIZ_DECLENSION_CASE_RECOGNITION_COUNT=3
QUIZ_DECLENSION_MATCH_COUNT=2

# WebClient response buffer limit для quiz-service (bytes)
QUIZ_WEB_CLIENT_MAX_IN_MEMORY_SIZE=2097152

# ── CORS ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://samskrtam.local

# ── Observability (Tracing with Tempo) ──────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

# ── Swagger / OpenAPI ───────────────────────────────────
SPRINGDOC_ENABLED=true

# ── Connection Pool Settings ────────────────────────────
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=3000

# ── Graceful Shutdown ───────────────────────────────────
GRACEFUL_SHUTDOWN_TIMEOUT=30s

FRONTEND_URL=http://samskrtam.local

# ── MinIO (for user avatars) ────────────────────────────
MINIO_URL=http://mdm-dev:9000
MINIO_EXTERNAL_URL=http://samskrtam.local
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=AdminAdmin#01
MINIO_BUCKET_AVATARS=samskrtam-avatars

# ── Mail Configuration ──────────────────────────────────
SPRING_MAIL_HOST=mailpit.sm.home
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=admin
SPRING_MAIL_PASSWORD=admin

# ── Application Base URL ────────────────────────────────
APP_BASE_URL=samskrtam.local

# ── Sangraha LLM ────────────────────────────────────────
# Конфигурации подключения к LLM (base-url, two-pass, max tokens) — в llm.yaml
# в корне репозитория. Активная модель выбирается здесь; API-ключ общий.
SANGRAHA_LLM_API_KEY=your-api-key
SANGRAHA_LLM_MODEL=claude-sonnet-5

# ── Curriculum Service ──────────────────────────────────
# Dedicated DB for curriculum-service (schema: curriculum), independent of content/quiz.
CURRICULUM_DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/curriculum
CURRICULUM_DB_USER=${DB_USER}
CURRICULUM_DB_PASSWORD=${DB_PASSWORD}